{
  "name": "@turingcare/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:predeploy": "tsx src/db/migrate-predeploy.ts",
    "db:push": "drizzle-kit push",
    "telemetry:purge": "tsx src/telemetry/retention-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@react-pdf/renderer": "^4.1.0",
    "@sentry/node": "^10.69.0",
    "@turingcare/i18n": "workspace:*",
    "@turingcare/shared": "workspace:*",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "pg": "^8.13.0",
    "resend": "^6.12.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
